# Relative directories resolve against the executable directory.
PEBRIL_LISTEN=127.0.0.1:8080
PEBRIL_DATA_DIR=data
# Defaults below are derived from the data root when unset.
# PEBRIL_PUBLIC_DIR=data/image/public
# PEBRIL_PRIVATE_DIR=data/image/private
# PEBRIL_DB_DIR=data/db
PEBRIL_NATIVE_DIR=bin
PEBRIL_AVIF=false
